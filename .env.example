# ═══════════════════════════════════════════════════════════════
# GuidEasy Logistics — Variáveis de Ambiente
# Copie este ficheiro para .env e configure os valores.
# ═══════════════════════════════════════════════════════════════

# ─── Base de Dados ─────────────────────────────────────────────
# Driver: pg (PostgreSQL), mysql2 (MySQL/MariaDB), mssql (SQL Server)
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_NAME=guideeasy
DB_USER=guideeasy
DB_PASSWORD=changeme

# Alternativa: string de conexão única (sobrepõe DB_HOST/PORT/etc.)
# DATABASE_URL=postgresql://guideeasy:changeme@localhost:5432/guideeasy

# ─── Opções SQL Server (apenas se DB_CLIENT=mssql) ────────────
# DB_ENCRYPT=false
# DB_TRUST_CERT=true

# ─── Autenticação ─────────────────────────────────────────────
# Chave secreta para assinar tokens JWT — MUDE ESTE VALOR!
JWT_SECRET=MUDE_ESTA_CHAVE_PARA_UMA_STRING_ALEATORIA_LONGA

# ─── Servidor ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
