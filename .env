# ─── Base de Dados (Por padrão local: SQLite3) ─────────────────
# Se preferir utilizar o PostgreSQL, comente as duas linhas abaixo
# e descomente a secção correspondente.
DB_CLIENT=sqlite3
DB_FILE=./guideeasy.sqlite

# Secção PostgreSQL (ativar para docker compose / staging / prod):
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=guideeasy
# DB_USER=guideeasy
# DB_PASSWORD=changeme

# ─── Autenticação ─────────────────────────────────────────────
JWT_SECRET=MUDE_ESTA_CHAVE_PARA_UMA_STRING_ALEATORIA_LONGA

# ─── Servidor ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000