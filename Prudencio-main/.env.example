# ═══════════════════════════════════════════════════════════════
# GuidEasy Logistics — Variáveis de Ambiente (Firebase Edition)
# Projeto Firebase: prudencio-main
# Copie este ficheiro para .env e configure os valores.
# ═══════════════════════════════════════════════════════════════

# ─── Firebase Admin SDK (Privado, Apenas Servidor) ────────────
# Pode configurar usando a string JSON da Conta de Serviço (Recomendado):
FIREBASE_SERVICE_ACCOUNT='{\"type\": \"service_account\", \"project_id\": \"prudencio-main\", ...}'

# OU usando chaves individuais:
# FIREBASE_PROJECT_ID=prudencio-main
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@prudencio-main.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC..."

# ─── Firebase Client SDK (Público, Exposto ao browser via VITE_) ──
# 👇 COLE AQUI o apiKey e appId que copiou da Consola Firebase:
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_APP_ID=1:37827545233:web:...

# 👇 Estes valores são deriváveis do Project ID:
VITE_FIREBASE_AUTH_DOMAIN=prudencio-main.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=prudencio-main
VITE_FIREBASE_STORAGE_BUCKET=prudencio-main.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=37827545233

# 👇 Opcionais (preencha se ativar Realtime DB / Analytics):
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Autenticação ─────────────────────────────────────────────
# Chave secreta para assinar tokens JWT — MUDE ESTE VALOR!
# Pode gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=MUDE_ESTA_CHAVE_PARA_UMA_STRING_ALEATORIA_LONGA_E_SEGURA

# ─── Definições do Administrador Inicial (Auto-seeding) ────────
ADMIN_EMAIL=admin@prudencio.pt
ADMIN_PASSWORD=Rpavg5n
ADMIN_NAME=Administrador

# ─── Servidor ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
