rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users (admin gerido pelo servidor) ─────────────────────
    match /users/{userId} {
      // Apenas o servidor (Admin SDK) pode ler/escrever users
      // O Admin SDK bypassa todas as regras
      allow read, write: if false;
    }

    // ─── App Users (colaboradores) ──────────────────────────────
    match /app_users/{userId} {
      allow read: if true;
      allow write: if false; // Apenas via Admin SDK
    }

    // ─── Obras ──────────────────────────────────────────────────
    match /obras/{obraId} {
      allow read: if true;
      allow write: if false; // Apenas via Admin SDK
    }

    // ─── Checklists ─────────────────────────────────────────────
    match /checklists/{checklistId} {
      allow read: if true;
      allow write: if false; // Apenas via Admin SDK
    }

    // ─── Teste de conexão (temporário) ──────────────────────────
    match /_connection_test/{docId} {
      allow read, write: if true;
    }
  }
}
