# ═══════════════════════════════════════════════════════════════
# GuidEasy Logistics — Variáveis de Ambiente (Neon PostgreSQL)
#
# Copie este ficheiro para .env.local e configure os valores reais.
# NUNCA cometa o ficheiro .env.local para o repositório.
# ═══════════════════════════════════════════════════════════════

# ─── Neon PostgreSQL ──────────────────────────────────────────
# Neon Console → Dashboard → Connection Details → Connection string
# Use a URL "pooled" para melhor performance em serverless.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-yyy.REGION.aws.neon.tech/DBNAME?sslmode=require

# ─── Autenticação JWT ─────────────────────────────────────────
# Chave secreta para assinar tokens JWT — MUDE ESTE VALOR!
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=MUDE_ESTA_CHAVE_PARA_UMA_STRING_ALEATORIA_LONGA_E_SEGURA

# ─── Administrador Inicial (Auto-seeding / Fallback) ──────────
ADMIN_EMAIL=admin@prudencio.pt
ADMIN_PASSWORD=MUDE_ESTA_PASSWORD_INICIAL
ADMIN_NAME=Administrador

# ─── Servidor ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
